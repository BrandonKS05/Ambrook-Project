# Copy to .env (gitignored) and fill in. The barn reads this on start.
#
#   cp .env.example .env
#
# With a key set, the categorizer switches from keyword rules to Claude.
ANTHROPIC_API_KEY=

# Optional overrides — defaults shown:
# PORT=4477
# BARN_DB=data/barn.sqlite
# BARN_BLOBS=data/blobs
# SADDLEBAG_CATEGORIZER=claude   # or: rules
# SADDLEBAG_CLAUDE_MODEL=claude-opus-5
